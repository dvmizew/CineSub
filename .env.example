# CineSub Environment Configuration
# Copy this file to .env and fill in your API credentials.

# -----------------------------------------------------------------------------
# OpenSubtitles.com REST API
# Register & generate your API Key at: https://www.opensubtitles.com/consumers
# -----------------------------------------------------------------------------
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key_here
OPENSUBTITLES_USER_AGENT=CineSub v0.2.0

# Optional OpenSubtitles credentials (increases daily download quotas)
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# -----------------------------------------------------------------------------
# SubDL API
# Register & obtain your API Key at: https://subdl.com
# -----------------------------------------------------------------------------
SUBDL_API_KEY=your_subdl_api_key_here

# -----------------------------------------------------------------------------
# SubSource API
# Register & obtain your API Key at: https://subsource.net
# -----------------------------------------------------------------------------
SUBSOURCE_API_KEY=your_subsource_api_key_here

# -----------------------------------------------------------------------------
# Subs.ro API
# Register & obtain your API Key at: https://subs.ro
# -----------------------------------------------------------------------------
SUBSRO_API_KEY=your_subsro_api_key_here

# -----------------------------------------------------------------------------
# BetaSeries API
# Register & obtain your API Key at: https://www.betaseries.com/api
# -----------------------------------------------------------------------------
BETASERIES_API_KEY=your_betaseries_api_key_here

# -----------------------------------------------------------------------------
# Assrt.net (Shooter.cn) API
# Register & obtain your API Token at: https://assrt.net
# -----------------------------------------------------------------------------
ASSRT_API_TOKEN=your_assrt_api_token_here

# -----------------------------------------------------------------------------
# TMDb (The Movie Database) API
# Generate your Read Access Token at: https://www.themoviedb.org/settings/api
# -----------------------------------------------------------------------------
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
TMDB_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Note: Gestdown (Addic7ed), BSPlayer (64-bit Hash), and AnimeTosho (Feed)
# are public and require no API tokens or keys.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
# Default subtitle language (ISO 639-1 code, e.g. en, ro, es, fr, de, it)
CINESUB_DEFAULT_LANGUAGE=en

# Network request timeout in seconds
CINESUB_TIMEOUT=15
